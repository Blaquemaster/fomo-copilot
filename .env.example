# Copy to .env and replace every value. This file is safe to commit.
# Do not put real tokens, passwords, or chat ids here.

NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=fomo
POSTGRES_PASSWORD=replace-me-postgres-password
POSTGRES_DB=fomo
DATABASE_URL=postgres://fomo:replace-me-postgres-password@postgres:5432/fomo

# From BotFather. The running process refuses to start until this is changed.
TELEGRAM_BOT_TOKEN=replace-me-telegram-bot-token

# Your private chat id (positive integer). 0 is rejected on purpose.
# In a private chat this is the same as your user id. Ask @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=0

# Present so the env schema matches production. The ingestor reads this key.
HELIUS_API_KEY=replace-me-helius-api-key

# developer until 2026-12-07, then set free. auto uses transactionSubscribe only on developer.
HELIUS_PLAN=developer
HELIUS_WS_MODE=auto
# dry-run still stores events and measures credits. Set continuous after the 24h soak.
INGEST_MODE=dry-run

# Backfill stops this many slots before the last live slot so a late event is not skipped.
BACKFILL_SLOT_MARGIN=16

THRESHOLDS_PATH=config/thresholds.yaml
