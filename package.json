{
  "name": "fomo-copilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "backfill:replay": "node apps/ingestor/dist/replay.js"
  },
  "overrides": {
    "@eslint-community/regexpp": "4.12.2",
    "brace-expansion": "5.0.12",
    "rollup": "4.67.2",
    "semver": "7.8.5",
    "thread-stream": "4.2.0",
    "vite": "7.3.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
